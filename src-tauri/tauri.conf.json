{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KODDAŞ",
  "version": "1.1.3",
  "identifier": "com.koddas.ai",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "label": "main", "title": "KODDAŞ — Local AI Coding Assistant", "width": 1440, "height": 900, "minWidth": 1080, "minHeight": 680 }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:11434; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline';" }
  },
  "bundle": { "active": true, "targets": "all", "shortDescription": "Local AI coding assistant", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.icns"] }
}
